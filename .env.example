# Required server configuration. Replace each empty value in your deployment.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=

# Optional: set by the runtime in standard Next.js deployments.
# NODE_ENV is assigned by Next.js.
# PORT is consumed by `next start` when explicitly set.
# PORT=

# Required only when using docker-compose.yml for local service containers.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
REDIS_PORT=
OLLAMA_PORT=

# Required only when running `npm run seed` to create the seed workspace owner.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# AI provider/model/API credentials and SMTP settings belong in each workspace's
# Integrations configuration. Never add those credentials to this file.

